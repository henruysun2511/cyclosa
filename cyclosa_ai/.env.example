# Server Config
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development

# Security
INTERNAL_API_KEY=cyclosa-internal-ai-secret-key-2026

# AI Providers
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
DEFAULT_LLM_MODEL=gemini/gemini-1.5-flash

# Timeout Config (in seconds)
SYNC_REQUEST_TIMEOUT=15
BATCH_REQUEST_TIMEOUT=60

# Redis Cache & Task Queue (Dùng làm cả Cache và Celery Broker)
REDIS_URL=redis://localhost:6379/1
